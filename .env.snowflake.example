# Copy to .env.snowflake (git-ignored) and fill in. No secrets here: only names and
# paths to key files that stay on your machine. Used by the sf-* / tf-* Makefile targets.

# Snowsight -> account menu -> "Connect a tool to Snowflake" shows both names.
SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=

# Admin service user (ACCOUNTADMIN, key-pair only) and its private key.
SF_ADMIN_USER=SVC_ADMIN
SF_ADMIN_KEY_PATH=/Users/<you>/.snowflake/keys/admin.p8

# Private key of the SVC_DBT service user (public half goes to terraform.tfvars).
SF_DBT_KEY_PATH=/Users/<you>/.snowflake/keys/svc_dbt.p8

# AWS CLI profile with rights to create the S3 bucket, KMS key and IAM role.
AWS_PROFILE=default

# Must equal landing_bucket_name in terraform/terraform.tfvars.
LANDING_BUCKET=
