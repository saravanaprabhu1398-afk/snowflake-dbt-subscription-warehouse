# Copy to .env (git-ignored). Read by `astro dev start`. No secrets: the key is a mounted file.
# dbt (profiles.yml prod target)
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=SVC_DBT
SNOWFLAKE_PRIVATE_KEY_PATH=/usr/local/airflow/secrets/svc_dbt.p8

# Airflow connection used by the Snowpipe sensor (no warehouse: metadata functions only).
AIRFLOW_CONN_SNOWFLAKE_DBT='{"conn_type": "snowflake", "login": "SVC_DBT", "extra": {"account": "<orgname>-<accountname>", "role": "TRANSFORMER", "database": "RAW", "private_key_file": "/usr/local/airflow/secrets/svc_dbt.p8", "authenticator": "SNOWFLAKE_JWT"}}'

# Optional: Slack-compatible incoming webhook for failure alerts. Unset = log only.
ALERT_WEBHOOK_URL=
